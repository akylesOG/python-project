def caesar_encrypt(text, shift):
    alphabet_lower = 'abcdefghijklmnopqrstuvwxyz'  # 32 буквы, без ё
    alphabet_upper = alphabet_lower.upper()
    result = ''
    
    for char in text:
        if char in alphabet_lower:
            index = alphabet_lower.index(char)
            new_index = (index + shift) % 26
            result += alphabet_lower[new_index]
        elif char in alphabet_upper:
            index = alphabet_upper.index(char)
            new_index = (index + shift) % 26
            result += alphabet_upper[new_index]
        else:
            result += char  # пробелы, знаки препинания без изменений
    
    return result


text = input()
for i in range(2,26):
    print(caesar_encrypt(text, i))